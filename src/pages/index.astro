---
const email = "mdl0394@gmail.com";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Lyons Share LLC</title>
    <meta
      name="description"
      content="Lyons Share LLC — independent software consulting by Mike Lyons. A professional software engineer from before LLMs were cool."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..900&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <div class="screen">
      <main class="stage">
        <div>
          <h1 class="statement">
            A professional software engineer from before LLMs were cool.
          </h1>
          <p class="tagline">Independent software consulting</p>
        </div>
      </main>

      <footer class="row row--end">
        <a class="email" href={`mailto:${email}`}>{email}</a>
        <span class="colophon">&copy; 2026 Lyons Share LLC</span>
      </footer>
    </div>

    <style is:global>
      /* ── Tokens ──────────────────────────────────────────────
         Ledger stock: the banded green paper financial printouts
         ran on, with one oxidized registration-stamp red. */
      :root {
        --ink: #16211b;
        --ink-soft: #47564c;
        --paper: #e9ede4;
        --rule: #b3c2aa;
        --stamp: #9e3b2e;

        --display: "Archivo", system-ui, sans-serif;
        --mono: "IBM Plex Mono", ui-monospace, monospace;

        --gutter: clamp(1.25rem, 5vw, 4rem);
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        height: 100%;
      }

      body {
        background: var(--paper);
        color: var(--ink);
        font-family: var(--mono);
        -webkit-font-smoothing: antialiased;
        overflow: hidden;
      }

      :focus-visible {
        outline: 2px solid var(--stamp);
        outline-offset: 4px;
      }

      /* One screen: the statement, then contact. */
      .screen {
        height: 100dvh;
        display: grid;
        grid-template-rows: 1fr auto;
        padding: clamp(1.5rem, 4vh, 2.75rem) var(--gutter);
        gap: clamp(1.5rem, 4vh, 3rem);
      }

      .row {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 1.5rem;
      }

      .row--end {
        align-items: flex-end;
      }

      /* ── The statement is the whole design ───────────────── */
      .stage {
        display: flex;
        align-items: center;
        min-height: 0;
      }

      .statement {
        margin: 0;
        font-family: var(--display);
        font-variation-settings: "wdth" 125, "wght" 800;
        font-size: min(7.6vw, 12.5vh, 6.5rem);
        line-height: 0.98;
        letter-spacing: -0.018em;
        max-width: 16ch;
        text-wrap: balance;
        animation: rise 0.8s cubic-bezier(0.22, 0.8, 0.24, 1) 120ms both;
      }

      @keyframes rise {
        from {
          opacity: 0;
          transform: translateY(0.35em);
        }
      }

      .tagline {
        margin: clamp(1.25rem, 3vh, 2rem) 0 0;
        font-size: clamp(0.68rem, 1.1vw, 0.8rem);
        text-transform: uppercase;
        letter-spacing: 0.2em;
        color: var(--ink-soft);
        animation: rise 0.8s cubic-bezier(0.22, 0.8, 0.24, 1) 320ms both;
      }

      /* ── Contact ─────────────────────────────────────────── */
      .email {
        font-family: var(--display);
        font-variation-settings: "wdth" 105, "wght" 700;
        font-size: clamp(0.95rem, 2vw, 1.35rem);
        color: var(--ink);
        text-decoration: none;
        border-bottom: 3px solid var(--stamp);
        padding-bottom: 0.15em;
      }

      .email:hover {
        color: var(--stamp);
      }

      .colophon {
        font-size: clamp(0.6rem, 1vw, 0.7rem);
        text-transform: uppercase;
        letter-spacing: 0.14em;
        color: var(--ink-soft);
      }

      /* ── Small screens ───────────────────────────────────── */
      @media (max-width: 40rem) {
        .statement {
          font-size: min(11vw, 9vh, 3.25rem);
          max-width: 14ch;
        }

        .row--end {
          flex-direction: column;
          align-items: flex-start;
          gap: 1.25rem;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .statement {
          animation: none;
        }
      }
    </style>
  </body>
</html>
